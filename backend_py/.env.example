# Copia este archivo como .env (solo para correr en tu computador). En Render se ponen en "Environment".

# --- Base de datos (Aiven) ---
# Opción A (recomendada): pega la "Service URI" de Aiven tal cual
DATABASE_URL=mysql://avnadmin:TU_CLAVE@mysql-xxxx-tuproyecto.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
# Opción B: variables sueltas (si usas estas, borra DATABASE_URL)
# DB_HOST=mysql-xxxx-tuproyecto.aivencloud.com
# DB_PORT=12345
# DB_NAME=defaultdb
# DB_USER=avnadmin
# DB_PASS=TU_CLAVE
# DB_SSL=true            # Aiven exige SSL. Para un MySQL local sin SSL: DB_SSL=false
# DB_CA_CERT=            # opcional: contenido de ca.pem de Aiven para verificar el servidor

# --- Seguridad ---
JWT_SECRET=pon-aqui-una-frase-larga-y-secreta
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Administrador inicial (se crea solo si no existe ningún admin) ---
ADMIN_EMAIL=tu_correo@gmail.com
ADMIN_PASSWORD=UnaClaveSegura123
ADMIN_NAME=Administrador

# --- Correo para el código OTP ---
# En Render gratis el SMTP está bloqueado: usa Brevo (API HTTP, 300 correos/día gratis)
BREVO_API_KEY=
MAIL_FROM=tu_correo@gmail.com
MAIL_FROM_NAME=Recoleccta
# Alternativa solo en local: SMTP de Gmail con contraseña de aplicación
# MAIL_PROVIDER=smtp
# MAIL_USERNAME=tu_correo@gmail.com
# MAIL_PASSWORD=contraseña_de_aplicacion
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# Sin correo configurado, el código se imprime en los logs del servidor (MAIL_PROVIDER=console).
