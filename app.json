{
  "expo": {
    "name": "frontend_recoleccta",
    "slug": "frontend_recoleccta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/9126d546-c1a7-4213-8269-36fe0c237397.jpg",
    "scheme": "frontendrecoleccta",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite acceso a tus fotos para adjuntar evidencia a los reportes.",
          "cameraPermission": "Permite acceso a la cámara para tomar evidencia fotográfica de los reportes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/9126d546-c1a7-4213-8269-36fe0c237397.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
