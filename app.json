{
  "expo": {
    "name": "Recoleccta",
    "slug": "frontend_recoleccta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontendrecoleccta",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.recoleccta.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite acceso a tus fotos para adjuntar evidencia a los reportes.",
          "cameraPermission": "Permite acceso a la cámara para tomar evidencia fotográfica de los reportes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/9126d546-c1a7-4213-8269-36fe0c237397.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Recoleccta usa tu ubicación para marcar dónde recoger los residuos o entregar el bidón."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
